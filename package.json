{
  "name": "ultimate-agents-both",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts --dev",
    "build": "tsc --noEmit && vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/index.js",
    "start": "node dist-server/index.js",
    "desktop": "electron desktop/main.cjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write client server shared desktop scripts tests docs *.json *.ts *.md",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "test:desktop": "node scripts/desktop-smoke.mjs",
    "setup:desktop": "node node_modules/electron/install.js",
    "test:windows": "tsx scripts/windows-smoke.ts",
    "package:windows": "npm run build && esbuild scripts/windows-smoke.ts scripts/windows-validation.ts --bundle --platform=node --format=esm --packages=external --outdir=dist-server && node scripts/package-windows.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "^9.3.0",
    "@sigstore/bundle": "5.0.0",
    "@sigstore/protobuf-specs": "0.5.2",
    "@sigstore/verify": "4.1.2",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.0",
    "playwright": "^1.56.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0",
    "typescript": "^5.9.0",
    "undici": "^8.12.1",
    "ws": "^8.18.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.7.2",
    "esbuild": "^0.25.0",
    "eslint": "^9.37.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.0"
  }
}
