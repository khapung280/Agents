# Copy to .env; Node loads it on startup. Never commit secrets.
PORT=4317
# Local storage, artifacts, and the private pairing token live here.
AGENTS_DATA_DIR=.data
# Public HTTPS destinations permitted for browser/research tools (exact hosts).
AGENTS_ALLOWED_HOSTS=example.com
# Optional provider: openai or anthropic. Leave unset for built-in local tools.
AGENTS_MODEL_PROVIDER=openai
AGENTS_MODEL=gpt-4.1-mini
AGENTS_OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Set verified provider rates in USD per million tokens to record cost estimates.
AGENTS_INPUT_PRICE_PER_MILLION=
AGENTS_OUTPUT_PRICE_PER_MILLION=
# For Playwright on Linux; omit to use its installed Chromium.
CHROMIUM_PATH=/usr/bin/chromium
